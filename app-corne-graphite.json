  "shiftOverrides": [
    "Shift + ' → _",
    "Shift + , → ?",
    "Shift + / → <",
    "Shift + - → \""
  ],
  "layerHolds": [
    {
      "hold": "Space (left thumb)",
      "layer": "Navigation",
      "detail": "Right hand: arrows, Home/End, PgUp/PgDn"
    },
    {
      "hold": "Tab (left thumb)",
      "layer": "Mouse",
      "detail": "Right hand: mouse movement and wheel; left hand: Cmd shortcuts"
    },
    {
      "hold": "Enter (right thumb)",
      "layer": "Symbols",
      "detail": "Left hand: shifted symbols"
    },
    {
      "hold": "Backspace (right thumb)",
      "layer": "Numbers",
      "detail": "Left hand: numpad"
    },
    {
      "hold": "Tab, then tap OS Fn",
      "layer": "Function",
      "detail": "One-shot: F-keys and media for the next key"
    }
  ],
  "notes": [
    "Combos work on the base layer only. Press the keys at the same time (combo term 50 ms).",
    "Home row mods: GUI, Alt, Ctrl, Shift (GACS) on N R T S and H A E I.",
    "Hold Space for Navigation, Tab for Mouse, Enter for Symbols, Backspace for Numbers.",
    "Function layer: tap OS Fn on the Mouse layer (one-shot layer).",
    "Lock (right outer thumb) keeps the current layer on until you press it again.",
    "Extra keys on the base layer: left Left and Play/Pause, right Right and Next track.",
    "Outer thumb keys: = (left) and ; (right).",
    "RGB: Typing Heatmap is the default effect after a Vial EEPROM reset."
  ],
