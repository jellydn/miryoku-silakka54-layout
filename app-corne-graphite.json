  "tooltips": {
    "L22": "N key | Hold: GUI modifier (175ms)",
    "L23": "R key | Hold: Alt modifier (175ms)",
    "L24": "T key | Hold: Ctrl modifier (175ms)",
    "L25": "S key | Hold: Shift modifier (175ms)",
    "LEX1": "Extra key: ←",
    "LEX2": "Extra key: Play",
    "LT2": "Space key | Hold: Navigation layer",
    "LT3": "Tab key | Hold: Mouse layer",
    "R22": "I key | Hold: GUI modifier (175ms)",
    "R23": "E key | Hold: Alt modifier (175ms)",
    "R24": "A key | Hold: Ctrl modifier (175ms)",
    "R25": "H key | Hold: Shift modifier (175ms)",
    "REX1": "Extra key: →",
    "REX2": "Extra key: Next",
    "RT2": "Bksp key | Hold: Numbers layer",
    "RT3": "Enter key | Hold: Symbols layer",
    "L12": "B key | Combo B + L → Escape | Combo B + L + D → Quit app (Cmd+Q)",
    "L13": "L key | Combo B + L → Escape | Combo L + D → Sticky GUI (Cmd) | Combo B + L + D → Quit app (Cmd+Q) | Combo L + W → Enter",
    "L14": "D key | Combo L + D → Sticky GUI (Cmd) | Combo B + L + D → Quit app (Cmd+Q) | Combo D + W → Sticky Hyper (Cmd+Ctrl+Alt+Shift)",
    "L15": "W key | Combo L + W → Enter | Combo D + W → Sticky Hyper (Cmd+Ctrl+Alt+Shift)",
    "L32": "Q key | Combo Q + X → Cut (Cmd+X)",
    "L33": "X key | Combo Q + X → Cut (Cmd+X) | Combo X + M → Copy (Cmd+C)",
    "L34": "M key | Combo X + M → Copy (Cmd+C)",
    "R15": "F key | Combo F + O → Sticky Meh (Ctrl+Alt+Shift) | Combo F + U → Escape",
    "R14": "O key | Combo F + O → Sticky Meh (Ctrl+Alt+Shift) | Combo O + U → Quote (')",
    "R13": "U key | Combo F + U → Escape | Combo O + U → Quote (')",
    "R34": ". key | Combo . + - → Sticky Meh (Ctrl+Alt+Shift)",
    "R33": "- key | Combo . + - → Sticky Meh (Ctrl+Alt+Shift)"
  },
  "combos": [
    {
      "keys": "B + L",
      "action": "Escape"
