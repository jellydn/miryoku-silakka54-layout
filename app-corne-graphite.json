    {
      "keys": "F + U",
      "action": "Escape"
    },
    {
      "keys": "O + U",
      "action": "Quote (')"
    },
    {
      "keys": ". + -",
      "action": "Sticky Meh (Ctrl+Alt+Shift)"
    }
